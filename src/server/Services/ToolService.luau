--!strict
-- Hand tools (the ladder, tiers 1-6, bought with the HUD card) and cars (owned separately,
-- bought at the Garage, kept in their own HUD slot). On foot you sweep with your tool; in a
-- car you get the car's radius and power. Driving is done by the client (it owns the physics).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local AssetLibrary = require(Shared.AssetLibrary)
local BigNum = require(Shared.BigNum)
local Format = require(Shared.Format)
local Net = require(Shared.Net)
local ToolGrips = require(Shared.Config.ToolGrips)
local Tools = require(Shared.Config.Tools)
local Items = require(Shared.Config.Items)
local Upgrades = require(Shared.Config.Upgrades)
local Avatar = require(script.Parent.Parent.Lib.Avatar)

local ToolService = {}

local S: any

-- The hand tool you sweep with: the one you picked in the Tools menu (any tier you own),
-- or your best one.
function ToolService:GetEffectiveTier(player: Player): number
	local data = S.DataService:GetData(player)
	if not data then
		return 1
	end
	local best = math.clamp(data.ToolTier, 1, Tools.MaxTier)
	local picked = data.EquippedTool
	return if type(picked) == "number" and picked >= 1 and picked <= best then picked else best
end

function ToolService:OwnsVehicle(player: Player, id: string): boolean
	local session = S.DataService:GetSession(player)
	if not session then
		return false
	end
	return session.Data.Vehicles[id] == true or session.Runtime.RentedVehicle == id
end

-- Best car you can drive (owned or rented), or nil.
function ToolService:GetBestVehicle(player: Player)
	local best = nil
	for _, def in Tools.Vehicles do
		if ToolService:OwnsVehicle(player, def.Id) and (best == nil or def.Order > best.Order) then
			best = def
		end
	end
	return best
end

function ToolService:GetCapacity(player: Player): number
	local data = S.DataService:GetData(player)
	local capacity = Tools.get(ToolService:GetEffectiveTier(player)).Capacity
	local car = ToolService:GetBestVehicle(player)
	if car then
		capacity = math.max(capacity, car.Capacity)
	end
	local mult = Upgrades.multiplier(data and data.Upgrades, "Backpack")
	if S.BoostService:IsBoostActive(player, "BigBag") then
		mult *= Items.BigBagMult
	end
	return math.floor(capacity * mult)
end

function ToolService:IsInVehicle(player: Player): boolean
	local session = S.DataService:GetSession(player)
	local vehicle = session and session.Runtime.Vehicle
	if not vehicle or not vehicle.Parent then
		return false
	end
	local seat = vehicle:FindFirstChild("Seat") :: VehicleSeat?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return seat ~= nil and humanoid ~= nil and seat.Occupant == humanoid
end

-- The stats used for sweeping right now: { Radius, Power }.
function ToolService:GetSweepTool(player: Player): { Radius: number, Power: number }
	local session = S.DataService:GetSession(player)
	local levels = session and session.Data.Upgrades
	local mult = Upgrades.multiplier(levels, "Power")
	if S.BoostService:IsBoostActive(player, "Leaf2x") then
		mult *= Items.LeafMult
	end
	local size = Upgrades.multiplier(levels, "Radius")
	if session and ToolService:IsInVehicle(player) then
		local car = Tools.vehicle(session.Runtime.VehicleId or "")
		if car then
			return { Radius = car.Radius * size, Power = car.Power * mult * Tools.carBoost(session.Data.ToolTier) }
		end
	end
	local def = Tools.get(ToolService:GetEffectiveTier(player))
	return { Radius = def.Radius * size, Power = def.Power * mult }
end

-- Grip for the Blender tools (business end at -Z). Each tool has its own hold and use
-- animations (Tool_<Id>_Hold / _Use) and its own rotation in the hand (Config/ToolGrips),
-- both generated by art/anim/tool_anims.py from the model's grip / grip2 / tip points, so the
-- tool is used at its modelled size. Old fallback (no ToolGrips entry): the broom grip, with
-- the tool scaled so its head reaches the ground.
local TOOL_REACH = 3.3 -- right hand to the end of the head
local HAND_GAP = 1.2
local GRIP_ROTATION = CFrame.fromMatrix(
	Vector3.zero,
	Vector3.new(0.8880, 0.4331, 0.1544),
	Vector3.new(-0.3791, 0.8797, -0.2871),
	Vector3.new(-0.2601, 0.1964, 0.9454)
):Inverse()

local function buildMeshTool(tool: Tool, def): boolean
	local model = AssetLibrary.get("Tool_" .. def.Id)
	local meta = AssetLibrary.meta("Tool_" .. def.Id)
	local handle = model and model:FindFirstChild("Handle") :: BasePart?
	if not model or not meta or not handle then
		return false
	end
	local rotation = (ToolGrips :: any)[def.Id] :: CFrame?
	local gripPoint: Vector3
	local tipPoint: Vector3? = meta.tip
	if rotation then
		gripPoint = meta.grip or handle.Position
	else
		local topGrip: Vector3 = meta.grip or handle.Position
		local length = topGrip.Z - meta.bounds.min.Z
		local scale = if length > 0 then math.clamp((TOOL_REACH + HAND_GAP) / length, 0.75, 2) else 1
		if math.abs(scale - 1) > 0.01 then
			model:ScaleTo(scale)
			topGrip *= scale
			handle = model:FindFirstChild("Handle") :: BasePart
		end
		gripPoint = topGrip - Vector3.new(0, 0, HAND_GAP)
		tipPoint = nil
	end
	local h = handle :: BasePart
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = false
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.Massless = true
			if part ~= h then
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = h
				weld.Part1 = part
				weld.Parent = part
			end
			part.Parent = tool
		end
	end
	-- Where the effects come out (ToolFxController): at the tip, +Y pointing out of the tool.
	if tipPoint then
		local out = tipPoint - gripPoint
		local tip = Instance.new("Attachment")
		tip.Name = "Tip"
		local up = if out.Magnitude > 0.01 then out.Unit else Vector3.new(0, 0, -1)
		local side = up:Cross(Vector3.new(0, 1, 0))
		if side.Magnitude < 0.01 then
			side = Vector3.new(1, 0, 0)
		end
		local world = CFrame.fromMatrix(tipPoint, side.Unit, up)
		tip.CFrame = h.CFrame:ToObjectSpace(world)
		tip.Parent = h
	end
	model:Destroy()
	tool.Grip = h.CFrame:ToObjectSpace(CFrame.new(gripPoint)) * (if rotation then rotation:Inverse() else GRIP_ROTATION)
	return true
end

local function buildTool(def): Tool
	local tool = Instance.new("Tool")
	tool.Name = def.Name
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.ToolTip = `Hold to sweep (radius {def.Radius})`
	tool:SetAttribute("SweepTool", true)
	tool:SetAttribute("Tier", def.Tier)
	tool:SetAttribute("ToolId", def.Id)
	if buildMeshTool(tool, def) then
		return tool
	end

	-- Models not loaded yet (or failed): a part-built stand-in, swapped once they load.
	tool:SetAttribute("Placeholder", true)
	local scale = def.Scale
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.3, 0.3, 3.2 * scale)
	handle.Color = Color3.fromRGB(235, 235, 240)
	handle.Material = Enum.Material.SmoothPlastic
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool

	local head = Instance.new("Part")
	head.Name = "Head"
	head.Size = Vector3.new(1.4 * scale, 0.5 * scale, 0.7 * scale)
	head.Color = def.Color
	head.Material = Enum.Material.SmoothPlastic
	head.CanCollide = false
	head.Massless = true
	head.CFrame = handle.CFrame * CFrame.new(0, 0, -1.6 * scale)
	head.Parent = tool
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = head
	weld.Parent = head

	-- Point the head down and forward, like holding a broom.
	tool.Grip = CFrame.new(0, 0, 0.6 * scale) * CFrame.Angles(math.rad(60), 0, 0)
	return tool
end

local giveTool: (Player, boolean) -> ()

-- A tool whose Handle is gone can't be held again (RequiresHandle), and pressing 1 then
-- does nothing until another tool is equipped (Dev, 2026-10-30). That happens when the
-- grip wasn't made yet (equipped while the avatar was still loading) and the loose tool
-- falls out of the world. Rebuild it as soon as the Handle goes.
local function watchHandle(player: Player, tool: Tool)
	local handle = tool:FindFirstChild("Handle")
	if not handle then
		return
	end
	handle.AncestryChanged:Connect(function()
		if handle:IsDescendantOf(tool) or tool:GetAttribute("Retired") or not tool.Parent or not player.Parent then
			return
		end
		local wasHeld = player.Character ~= nil and tool.Parent == player.Character
		task.defer(giveTool, player, wasHeld)
	end)
end

function giveTool(player: Player, equip: boolean)
	local character = player.Character
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not character or not backpack then
		return
	end
	for _, container in { backpack, character } do
		for _, child in container:GetChildren() do
			if child:IsA("Tool") and child:GetAttribute("SweepTool") then
				child:SetAttribute("Retired", true)
				child:Destroy()
			end
		end
	end
	local def = Tools.get(ToolService:GetEffectiveTier(player))
	local tool = buildTool(def)
	tool.Parent = backpack
	watchHandle(player, tool)
	if not equip then
		return
	end
	-- Equip once the body is in the world with its right hand, so the grip weld gets made.
	task.spawn(function()
		local deadline = os.clock() + 10
		while os.clock() < deadline do
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
			if humanoid and hand and character:IsDescendantOf(Workspace) then
				break
			end
			task.wait(0.1)
		end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 and tool.Parent == backpack and player.Character == character then
			humanoid:EquipTool(tool)
		end
	end)
end

local function destroyVehicle(player: Player)
	local session = S.DataService:GetSession(player)
	if session and session.Runtime.Vehicle then
		session.Runtime.Vehicle:Destroy()
		session.Runtime.Vehicle = nil
		session.Runtime.VehicleId = nil
		S.StateService:Mark(player)
	end
end

local function buildVehicle(player: Player, def): Model
	local s = def.Scale
	local model = Instance.new("Model")
	model.Name = player.Name .. "_" .. def.Id
	model:AddTag("SweepVehicle")
	local chassis = Instance.new("Part")
	chassis.Name = "Chassis"
	chassis.Size = Vector3.new(6 * s, 1.6 * s, 9 * s)
	chassis.Color = def.Color
	chassis.Material = Enum.Material.SmoothPlastic
	chassis.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0, 0, 100, 1)
	-- The box rides `clearance` above the ground on ray suspension (VehicleController), so
	-- it never scrapes floor seams or small steps; the wheels reach down to the ground.
	local clearance = 0.9 * s
	chassis:SetAttribute("Clearance", clearance)
	chassis.Parent = model
	model.PrimaryPart = chassis

	local function attach(part: BasePart, offset: CFrame)
		part.CFrame = chassis.CFrame * offset
		part.Massless = true
		part.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = chassis
		weld.Part1 = part
		weld.Parent = part
	end

	-- The chassis box only carries the mass. A shorter, higher Hull does the colliding
	-- (walls, fences, buildings), so the box's long flat ends never dig into the ground at
	-- the top or bottom of a ramp (Dev, 2026-10-30: the truck stuck on a ramp edge).
	chassis.CanCollide = false
	local hull = Instance.new("Part")
	hull.Name = "Hull"
	hull.Size = Vector3.new(5.6 * s, 1.2 * s, 7 * s)
	hull.CustomPhysicalProperties = PhysicalProperties.new(0.01, 0, 0, 100, 1)
	hull.CanQuery = false
	hull.Transparency = 1
	attach(hull, CFrame.new(0, 0.5 * s, 0))

	local seat = Instance.new("VehicleSeat")
	seat.Name = "Seat"
	seat.Size = Vector3.new(2, 1, 2)
	seat.Color = Color3.fromRGB(40, 40, 50)
	seat.HeadsUpDisplay = false
	seat.MaxSpeed = def.Speed
	seat:SetAttribute("Speed", def.Speed)
	seat:SetAttribute("OwnerUserId", player.UserId)
	attach(seat, CFrame.new(0, 0.8 * s + 0.5, 1 * s))

	local brush = Instance.new("Part")
	brush.Name = "Brush"
	brush.Shape = Enum.PartType.Cylinder
	brush.Size = Vector3.new(6.5 * s, 1.4 * s, 1.4 * s)
	brush.Color = Color3.fromRGB(255, 230, 120)
	brush.Material = Enum.Material.Fabric
	brush.CanCollide = false
	attach(brush, CFrame.new(0, -0.1 * s - clearance, -5 * s)) -- bottom on the ground

	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			local wheel = Instance.new("Part")
			wheel.Name = "Wheel"
			wheel.Shape = Enum.PartType.Cylinder
			wheel.Size = Vector3.new(0.8 * s, 2 * s, 2 * s)
			wheel.Color = Color3.fromRGB(30, 30, 35)
			wheel.CanCollide = false
			attach(wheel, CFrame.new(x * 3.1 * s, 0.2 * s - clearance, z * 3 * s)) -- resting on the ground
		end
	end

	-- Keeps the vehicle upright; the driving client turns it by updating the CFrame.
	local rootAttachment = Instance.new("Attachment")
	rootAttachment.Name = "Root"
	rootAttachment.Parent = chassis
	local align = Instance.new("AlignOrientation")
	align.Name = "Upright"
	align.Mode = Enum.OrientationAlignmentMode.OneAttachment
	align.Attachment0 = rootAttachment
	align.MaxTorque = math.huge
	align.Responsiveness = 30 -- quick enough to follow ramps, soft enough to lean in corners
	align.Parent = chassis

	-- Blender body on top of the physics box. Its origin sits on the ground under the wheels.
	-- Scaled up to the physics box's width. Wheels and the brush roller hang on Motor6Ds at
	-- their hubs so every client can spin and steer them (VehicleController).
	local visual = AssetLibrary.get("Vehicle_" .. def.Id)
	local meta = AssetLibrary.meta("Vehicle_" .. def.Id)
	if visual then
		local width = if meta and meta.bounds then meta.bounds.max.X - meta.bounds.min.X else 6 * s
		local k = math.clamp(6 * s / math.max(width, 1), 1, 2)
		if math.abs(k - 1) > 0.01 then
			visual:ScaleTo(k)
		end
		visual:SetAttribute("VisualScale", k)
		-- The body stands on the ground, `clearance` under the riding chassis box.
		local base = chassis.CFrame * CFrame.new(0, -chassis.Size.Y / 2 - clearance, 0)
		visual:PivotTo(base)
		local parts = meta and meta.parts or {}
		for _, part in visual:GetDescendants() do
			if part:IsA("BasePart") then
				part.Anchored = false
				part.CanCollide = false
				part.CanQuery = false
				part.CanTouch = false
				part.Massless = true
				local info = parts[part.Name]
				local joint: Vector3? = info and info.joint
				local spins = joint ~= nil and (string.sub(part.Name, 1, 6) == "Wheel_" or part.Name == "Brush")
				if spins then
					local hub = base * CFrame.new((joint :: Vector3) * k)
					local motor = Instance.new("Motor6D")
					motor.Name = "Spin"
					motor.Part0 = chassis
					motor.Part1 = part
					motor.C0 = chassis.CFrame:ToObjectSpace(hub)
					motor.C1 = part.CFrame:ToObjectSpace(hub)
					motor:SetAttribute("Radius", math.max((joint :: Vector3).Y * k, 0.3))
					motor:SetAttribute("Steer", part.Name == "Wheel_FL" or part.Name == "Wheel_FR")
					motor:SetAttribute("Brush", part.Name == "Brush")
					motor.Parent = part
				else
					local weld = Instance.new("WeldConstraint")
					weld.Part0 = chassis
					weld.Part1 = part
					weld.Parent = part
				end
			end
		end
		visual.Name = "Visual"
		visual.Parent = model
		for _, part in model:GetChildren() do
			if part:IsA("BasePart") then
				part.Transparency = 1
			end
		end
		if meta and meta.seat then
			local seatWeld = seat:FindFirstChildOfClass("WeldConstraint")
			if seatWeld then
				seatWeld.Enabled = false
			end
			-- meta.seat is the top of the seat cushion; the driver sits on the VehicleSeat's top face.
			-- Cab vehicles sit the driver lower (SeatDrop) so a default-size head fits under the cab roof.
			seat.CFrame = base * CFrame.new(meta.seat * k - Vector3.new(0, seat.Size.Y / 2 + 0.05 * k + (def.SeatDrop or 0), 0))
			if seatWeld then
				seatWeld.Enabled = true
			end
		end
	end
	Avatar.setGroup(model, Avatar.VehicleGroup)
	return model
end

-- Spawns a car you own (best one if id is nil) where you stand and seats you in it.
local function spawnVehicle(player: Player, id: string?): (boolean, string?)
	local session = S.DataService:GetSession(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not session or not humanoid or not root or humanoid.Health <= 0 then
		return false, "Not ready"
	end
	local def = if id then Tools.vehicle(id) else ToolService:GetBestVehicle(player)
	if not def then
		return false, "Buy a car in Gear first!"
	end
	if not ToolService:OwnsVehicle(player, def.Id) then
		return false, `You don't own the {def.Name}`
	end
	destroyVehicle(player)
	local model = buildVehicle(player, def)
	local look = root.CFrame.LookVector * Vector3.new(1, 0, 1)
	local facing = if look.Magnitude > 0.01 then CFrame.lookAt(Vector3.zero, look.Unit) else CFrame.identity
	local spot = CFrame.new(root.Position + Vector3.new(0, 3 * def.Scale, 0)) * facing
	model:PivotTo(spot)
	local align = (model.PrimaryPart :: BasePart):FindFirstChild("Upright") :: AlignOrientation
	align.CFrame = spot.Rotation
	model.Parent = Workspace
	session.Runtime.Vehicle = model
	session.Runtime.VehicleId = def.Id
	local chassis = model.PrimaryPart :: BasePart
	chassis:SetNetworkOwner(player)

	local seat = model:FindFirstChild("Seat") :: VehicleSeat
	-- The driver's body collides with nothing while seated (Avatar.DriverGroup).
	local function driverGroup(group: string)
		for _, d in character:GetDescendants() do
			if d:IsA("BasePart") then
				d.CollisionGroup = group
			end
		end
	end
	seat:Sit(humanoid)
	-- Sit can miss right after the car appears (the character is still settling): retry.
	task.spawn(function()
		for _ = 1, 6 do
			task.wait(0.25)
			if seat.Occupant or not seat.Parent or session.Runtime.Vehicle ~= model then
				return
			end
			if humanoid.Health > 0 and not humanoid.SeatPart then
				character:PivotTo(seat.CFrame * CFrame.new(0, 3, 0))
				seat:Sit(humanoid)
			end
		end
		if not seat.Occupant and session.Runtime.Vehicle == model then
			destroyVehicle(player) -- never got in: don't leave an empty car behind
		end
	end)
	if seat.Occupant then
		driverGroup(Avatar.DriverGroup)
	end
	-- Leaving the seat puts the vehicle away.
	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		S.StateService:Mark(player)
		if character.Parent then
			driverGroup(if seat.Occupant == humanoid then Avatar.DriverGroup else Avatar.PlayerGroup)
		end
		if seat.Occupant == nil then
			task.delay(1, function()
				if seat.Occupant == nil and session.Runtime.Vehicle == model then
					destroyVehicle(player)
				end
			end)
		end
	end)
	S.StateService:Mark(player)
	return true, nil
end

local function buyVehicle(player: Player, id: string): (boolean, string)
	local data = S.DataService:GetData(player)
	local def = if type(id) == "string" then Tools.vehicle(id) else nil
	if not data or not def then
		return false, "Unknown car"
	end
	if data.Vehicles[def.Id] then
		return false, "You already own it"
	end
	if data.Rebirths < def.RequiredRebirths then
		return false, `Rebirth {def.RequiredRebirths} needed for the {def.Name}`
	end
	if not S.BackpackService:TrySpend(player, def.Price, "Vehicle_" .. def.Id) then
		return false, `Need {Format.cash(def.Price)}`
	end
	data.Vehicles[def.Id] = true
	S.StateService:Mark(player)
	return true, `Got the {def.Name}! Spawn it here or from your car slot.`
end

-- Robux "unlock": owned until rebirth, same as buying it with cash.
function ToolService:GrantVehicle(player: Player, id: string): boolean
	local data = S.DataService:GetData(player)
	local def = Tools.vehicle(id)
	if not data or not def or data.Vehicles[id] then
		return false
	end
	data.Vehicles[id] = true
	S.StateService:Mark(player)
	return true
end

-- Sets the owned tier (bought or skipped via product). Fills every tier below it.
function ToolService:SetTier(player: Player, tier: number)
	local data = S.DataService:GetData(player)
	if not data then
		return
	end
	tier = math.clamp(tier, 1, Tools.MaxTier)
	data.ToolTier = tier
	data.EquippedTool = nil -- a new tool goes straight into your hands
	data.OwnedTools = {}
	for t = 1, tier do
		data.OwnedTools[t] = true
	end
	giveTool(player, true)
	S.AnalyticsService:ToolTier(player, tier, Tools.get(tier).Name)
	S.StateService:Mark(player)
end

function ToolService:Rent(player: Player, vehicleId: string)
	local session = S.DataService:GetSession(player)
	local def = Tools.vehicle(vehicleId)
	if not session or not def then
		return
	end
	local current = Tools.vehicle(session.Runtime.RentedVehicle or "")
	if not current or current.Order < def.Order then
		session.Runtime.RentedVehicle = def.Id
	end
	S.StateService:Mark(player)
	Net.fire("Notify", player, `{def.Name} unlocked for this run! Tap your car slot to drive.`, "Good")
end

function ToolService:ResetForRebirth(player: Player)
	local session = S.DataService:GetSession(player)
	if not session then
		return
	end
	session.Runtime.RentedVehicle = nil
	session.Data.Vehicles = {}
	destroyVehicle(player)
	ToolService:SetTier(player, 1)
end

local function buyNext(player: Player): (boolean, string)
	local data = S.DataService:GetData(player)
	if not data then
		return false, "Still loading"
	end
	local nextTier = data.ToolTier + 1
	if nextTier > Tools.MaxTier then
		return false, "You have the best tool!"
	end
	local def = Tools.get(nextTier)
	local price = def.Price
	if nextTier == 2 then
		price = Tools.tutorialPrice(price, BigNum.toNumber(data.Cash), data.Flags.TutorialDone == true)
	end
	if BigNum.lt(data.Cash, price) then
		S.ShopService:OfferCashFor(player, BigNum.sub(price, data.Cash))
		return false, `Need {Format.cash(price)}`
	end
	data.Cash = BigNum.sub(data.Cash, price)
	S.AnalyticsService:Sink(player, price, Enum.AnalyticsEconomyTransactionType.Shop, "Tool_" .. def.Id)
	ToolService:SetTier(player, nextTier)
	S.OfferService:OnToolBought(player)
	if nextTier > Tools.CarBoost.FromTier then
		return true, `Got the {def.Name}! Your cars sweep +{math.round((Tools.carBoost(nextTier) - 1) * 100)}% too`
	end
	return true, `Got the {def.Name}!`
end

function ToolService:Init(services)
	S = services
	Net.onInvoke("BuyNextTool", buyNext)
	-- Use any tool you own (Tools menu), not only the best one.
	Net.onInvoke("EquipTool", function(player, tier: any)
		local data = S.DataService:GetData(player)
		if not data then
			return false, "Still loading"
		end
		if tier == nil then
			-- No tier: just put your current tool back in your hands.
			giveTool(player, true)
			return true, nil
		end
		if type(tier) ~= "number" or tier ~= math.floor(tier) or tier < 1 or tier > data.ToolTier then
			return false, "You don't own that tool"
		end
		data.EquippedTool = if tier == data.ToolTier then nil else tier
		giveTool(player, true)
		S.StateService:Mark(player)
		return true, `{Tools.get(tier).Name} equipped`
	end)
	Net.onInvoke("ToggleVehicle", function(player)
		local session = S.DataService:GetSession(player)
		if session and session.Runtime.Vehicle then
			destroyVehicle(player)
			return true, nil
		end
		return spawnVehicle(player, nil)
	end)
	Net.onInvoke("SpawnVehicle", function(player, id)
		if type(id) ~= "string" then
			return false, "Unknown car"
		end
		-- From the Gear window: at your feet.
		return spawnVehicle(player, id)
	end)
	Net.onInvoke("BuyVehicle", buyVehicle)
	S.BaseService.CharacterReady:Connect(function(player: Player, character: Model)
		destroyVehicle(player)
		character:WaitForChild("Humanoid", 10)
		giveTool(player, true)
	end)
	S.DataService.ProfileReleasing:Connect(function(player)
		destroyVehicle(player)
	end)
	-- Players who spawned before the Blender models finished loading got a stand-in tool.
	S.AssetService.Ready:Connect(function()
		for _, player in Players:GetPlayers() do
			local character = player.Character
			local backpack = player:FindFirstChildOfClass("Backpack")
			for _, container in { character, backpack } do
				local tool = container and container:FindFirstChildWhichIsA("Tool")
				if tool and tool:GetAttribute("SweepTool") and tool:GetAttribute("Placeholder") then
					giveTool(player, tool.Parent == character)
					break
				end
			end
		end
	end)
end

function ToolService:Start()
	Players.PlayerRemoving:Connect(function(player)
		destroyVehicle(player)
	end)
end

return ToolService
