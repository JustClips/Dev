--!strict
-- Zones (GAME_PLAN §5.6). Dust tiles are generated by the server from these bounds,
-- so the world files only hold ground, walls and gates.
-- Layout: zones run along -Z. Landing Site is centered on the origin with the Rocket
-- in the middle and the 8 base plots in a ring (radius BaseRingRadius).
local Types = require(script.Parent.Parent.Types)

type ZoneDef = Types.ZoneDef

local BASE_COUNT = 8
local BASE_RING_RADIUS = 70
local BASE_CLEAR_RADIUS = 17 -- no dust on base plots
local ROCKET_CLEAR_RADIUS = 16

local landingExclusions: { Types.Exclusion } = {
	{ Center = Vector2.new(0, 0), Radius = ROCKET_CLEAR_RADIUS },
}
for i = 1, BASE_COUNT do
	local angle = math.rad((i - 1) * (360 / BASE_COUNT))
	table.insert(landingExclusions, {
		Center = Vector2.new(math.sin(angle) * BASE_RING_RADIUS, math.cos(angle) * BASE_RING_RADIUS),
		Radius = BASE_CLEAR_RADIUS,
	})
end

local List: { ZoneDef } = {
	{
		Id = "Landing",
		Name = "Landing Site",
		Planet = "Moon",
		IsMoon = true,
		UnlockCost = 0,
		RequiredRebirths = 0,
		Min = Vector2.new(-100, -100),
		Max = Vector2.new(100, 100),
		GroundY = 0,
		TileSize = 4,
		DustHP = 2,
		DustPerTile = 1,
		CashMult = 1,
		EggChance = 1 / 220,
		MaxRarity = "Uncommon",
		RegrowSeconds = 45,
		DustColor = Color3.fromRGB(214, 192, 150),
		Exclusions = landingExclusions,
	},
	{
		Id = "Crater",
		Name = "Crater",
		Planet = "Moon",
		IsMoon = true,
		UnlockCost = 5_000,
		RequiredRebirths = 0,
		Min = Vector2.new(-80, -246),
		Max = Vector2.new(80, -122),
		GroundY = -6,
		TileSize = 4,
		DustHP = 10,
		DustPerTile = 2,
		CashMult = 3,
		EggChance = 1 / 260,
		MaxRarity = "Rare",
		RegrowSeconds = 60,
		DustColor = Color3.fromRGB(196, 206, 230),
		Exclusions = {},
	},
	{
		Id = "DarkSide",
		Name = "Dark Side",
		Planet = "Moon",
		IsMoon = true,
		UnlockCost = 250_000,
		RequiredRebirths = 0,
		Min = Vector2.new(-80, -400),
		Max = Vector2.new(80, -276),
		GroundY = 0,
		TileSize = 4,
		DustHP = 60,
		DustPerTile = 3,
		CashMult = 10,
		EggChance = 1 / 300,
		MaxRarity = "Epic",
		RegrowSeconds = 75,
		DustColor = Color3.fromRGB(120, 90, 200),
		Exclusions = {},
	},
	{
		Id = "Mars",
		Name = "Mars Plains",
		Planet = "Mars",
		IsMoon = false,
		UnlockCost = 2_000_000,
		RequiredRebirths = 1,
		Min = Vector2.new(-80, -556),
		Max = Vector2.new(80, -432),
		GroundY = 0,
		TileSize = 4,
		DustHP = 300,
		DustPerTile = 5,
		CashMult = 40,
		EggChance = 1 / 340,
		MaxRarity = "Mythic",
		RegrowSeconds = 90,
		DustColor = Color3.fromRGB(220, 110, 70),
		Exclusions = {},
	},
}

local Zones = {
	List = List,
	ById = {} :: { [string]: ZoneDef },
	StartZone = "Landing",
	BaseCount = BASE_COUNT,
	BaseRingRadius = BASE_RING_RADIUS,
	-- Dust sits this high above the zone ground.
	TileHeight = 0.3,
}

for _, zone in List do
	Zones.ById[zone.Id] = zone
end

return Zones
